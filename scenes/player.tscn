[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/player/player.gd" id="1_player"]

[sub_resource type="RectangleShape2D" id="RectangleShape2D_feet"]
size = Vector2(12, 6)

; ── 玩家角色装配（E1-S4，架构 A6；R2-CHARSPRITE 换装 2026-09-06）────
; 结构约定（全项目复用，改动须同步 player.gd 头注释）：
;   根节点 (0,0) = 脚底触地点（y-sort 排序基准）
;   ├── Body          AnimatedSprite2D  凯尔行走图（Antifarea 十六像 M1，帧网
;                                       实测见 assets/characters/charset_frames.md）；
;                                       position (0,-9)：单帧 16x18 居中锚，
;                                       绘制范围 x∈[-8,8] y∈[-18,0]，脚踩原点不变
;                                       （E1 占位矩形同规格——只换载体类型，
;                                       脚底原点/y-sort 规则零触碰）。
;                                       SpriteFrames 由 char_anim.gd 构建注入
;                                       （player.gd _ready 装配，8 动画）；
;                                       过滤 Nearest（project.godot 项目级）、
;                                       z_index 默认 0（y-sort 三条件）。
;   ├── Collision     CollisionShape2D  12x6 矩形，中心 (0,-3)：只框"脚"。
;                                       俯视惯例——墙挡脚不挡头，头部可与墙缘重叠。
;   ├── InteractRay   RayCast2D         交互射线：起点胸口 (0,-10)，E1-S6 消费；
;                                       collision_mask = 1|2（墙体+交互层），排除
;                                       遮挡层（第4值）——被遮挡≠不可交互（俯视惯例）。
;                                       E5-M5：collide_with_areas 开——Boss 事件壳
;                                       是 Area2D（trigger_event_shell），默认关时
;                                       射线对 Area2D 完全不可见（E1-S6 探针矩阵
;                                       实测结论的前提即本开关默认关），Z 键打不中壳。
;   ├── OcclusionRay  RayCast2D         遮挡自检射线：起点脚底 (0,0) 向下 12px，
;                                       collision_mask = 4（仅遮挡层），只做日志自证。
;   └── Camera2D                        跟随相机（取舍依据见 player.gd 头注释）：
;                                       smoothing 开(speed 8)；Godot 4.x 相机级
;                                       无 snap 属性——A6 所指"snap 关"由 ADR-4 全局
;                                       snap_2d_transforms_to_pixel 承担，此处无可调项。
; 层位约定（2 的幂次可叠加，与 A6 地图分层配套；E2-S2 扩展）：
;   1 = 世界墙体（墙/障碍，挡脚）  2 = 交互物（NPC/宝箱/触发区）
;   4 = y-sort 遮挡物（可站立遮挡，不挡行走）
;   8 = 敌人实体（敌人间互不挡：敌人 mask 不含 8）  16 = 玩家实体
; 玩家层位（E2-S2 起正式入位）：
;   collision_layer = 16（玩家实体）：敌人 TouchArea mask=16 依赖它判定接触；
;     （E1 期占位 layer=1 与墙同层，E2-S2 敌人接触判定要求独立实体层，改之；
;     InteractRay mask=3 不受影响——射线看的是"标靶的层"，与自身层无关）
;   collision_mask = 9（层1墙体 | 层8敌人）：撞墙 + 被敌人挡（俯视惯例
;     "接触前先被实体挡半步，再由接触区触发遇敌"，贴合探索 GDD §3.2）。
; 运动模式：脚本 _ready 强制 MOTION_MODE_FLOATING（俯视必需，原因见脚本注释）。

[node name="Player" type="CharacterBody2D" groups=["player"]]
script = ExtResource("1_player")
collision_layer = 16
collision_mask = 9

[node name="Body" type="AnimatedSprite2D" parent="."]
position = Vector2(0, -9)

[node name="Collision" type="CollisionShape2D" parent="."]
position = Vector2(0, -3)
shape = SubResource("RectangleShape2D_feet")

[node name="InteractRay" type="RayCast2D" parent="."]
position = Vector2(0, -10)
enabled = false
collision_mask = 3
collide_with_areas = true

[node name="OcclusionRay" type="RayCast2D" parent="."]
target_position = Vector2(0, 12)
enabled = false
collision_mask = 4

[node name="Camera2D" type="Camera2D" parent="."]
position_smoothing_enabled = true
position_smoothing_speed = 8.0
