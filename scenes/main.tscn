[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/main/main_controller.gd" id="1_mainctrl"]

; ── E1-S3 正式常驻根（架构 A4）──────────────────────────────────
; Main（Node，常驻根，挂 main_controller.gd：结构自检 + 初始装载）
; ├── World      Node        ← 唯一"当前场景容器"，SceneRouter 只替换其子节点
; └── UILayer    CanvasLayer ← 跨场景常驻 UI 层（layer=10 盖在 World 之上）
;     ├── TestLabel  Label     ← SMK-11 验活用测试 Label（底部居中）
;     └── FadeMask   ColorRect ← 0.2s 淡入淡出过渡遮罩（SceneRouter 驱动；
;                                驻留期 visible=false + alpha=0，且 mouse_filter=2
;                                保证永不吞输入）
; 渲染基线由 project.godot（ADR-4）全局保证：640×360、整数缩放、Nearest。
; 本场景不写任何坐标级视觉属性（白盒阶段无需美术对齐）。

[node name="Main" type="Node"]
script = ExtResource("1_mainctrl")

[node name="World" type="Node" parent="."]

[node name="UILayer" type="CanvasLayer" parent="."]
layer = 10

[node name="TestLabel" type="Label" parent="UILayer"]
unique_name_in_owner = true
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -280.0
offset_top = -30.0
offset_right = 280.0
offset_bottom = -10.0
grow_horizontal = 2
grow_vertical = 0
theme_override_font_sizes/font_size = 16
text = "UILayer 存活验证（SMK-11）"
horizontal_alignment = 1
vertical_alignment = 1

[node name="FadeMask" type="ColorRect" parent="UILayer"]
unique_name_in_owner = true
visible = false
modulate = Color(1, 1, 1, 0)
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 1)
